.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
# Run outputs. Day-1 results and the corpus are small and committed on purpose;
# bulky per-run artifacts are not.
artifacts/runs/
artifacts/ledger.jsonl
cachegrind.out.*

# Private idea-selection research (competitor analysis); not for the public repo
research/
artifacts/cache/
artifacts/archive/
# Backtest scratch runs; only published results are committed
artifacts/backtest/*
!artifacts/backtest/packaging-v2/
!artifacts/backtest/packaging-v3/
# Adjudication runs; only Token Factory runs that feed published numbers get committed
artifacts/adjudication/*
!artifacts/adjudication/packaging-v2/
!artifacts/adjudication/packaging-v3/
# Built report (CI builds it from committed artifacts; see .github/workflows/pages.yml)
/site/
.claude/launch.json
