              "size_meaning": "Number of extra names inside the brackets",
              "make_source": "\ndef make(n):\n    # Build a requirement with n extras: pkg[extra0,extra1,...]\n    extras = ','.join(f'extra{i}' for i in range(n))\n    req = f'pkg[{extras}]'\n    return [[req]]",
