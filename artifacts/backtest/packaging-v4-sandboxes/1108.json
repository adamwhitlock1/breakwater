          "families": [
            {
              "id": "F1",
              "kind": "suspected_slowdown",
              "family": "many_specs_hash_first",
              "why": "SpecifierSet now lazily sorts its specs on first order‑sensitive operation. __hash__ triggers a full O(n log n) sort before any __str__ call, whereas the base version hashed the frozenset in O(n). Repeated hashing of a large set before any string conversion therefore becomes slower.",
              "size_meaning": "Number of distinct specifiers in the comma‑separated string (n). Cost grows roughly as n log n for the first hash.",
              "make_source": "\ndef make(n):\n    # generate n distinct simple specifiers, e.g. \">=1.0.0\", \">=1.1.0\", …\n    specs = [f\">={i}.0.0\" for i in range(1, n+1)]\n    spec_string = \",\".join(specs)\n    # one argument list per call – the benchmark can instantiate many times\n    return [[spec_string]]",
              "example_args": [],
              "origin": "plan",
              "screen_ratio": 0.4026765225057491,
              "valid_fraction": 1.0,
              "error": null
            },
            {
              "id": "F2",
              "kind": "suspected_slowdown",
              "family": "Large SpecifierSet (≥ 50 specifiers) where the first hash/equality operation forces a full sort",
              "why": "Head lazily sorts the internal tuple on first order‑sensitive operation (__hash__, __eq__, __str__). The old version used a frozenset whose hash/equality are O(n) without sorting. For a large set the first hash now costs O(n log n) vs O(n) before.",
              "size_meaning": "Number of distinct specifiers in the comma‑separated string passed to the constructor.",
              "make_source": "\ndef make(n):\n    # Generate n distinct simple specifiers like '>=1.0', '>=2.0', …\n    specs = [f\">={i}.0\" for i in range(1, n+1)]\n    spec_string = \",\".join(specs)\n    # Each element of the returned list is an argument tuple for the constructor.\n    # The benchmark will typically call SpecifierSet(*args).\n    return [[spec_string]]",
              "example_args": [],
              "origin": "plan",
              "screen_ratio": 0.413594095426172,
              "valid_fraction": 1.0,
              "error": null
            },
            {
              "id": "F3",
              "kind": "suspected_slowdown",
              "family": "many_specifiers_hash",
              "why": "Head stores specs as a tuple and lazily sorts on first __hash__/__eq__/__str__. A SpecifierSet with many comma‑separated specifiers triggers an O(n log n) sort before the tuple can be hashed, whereas the base version kept a frozenset whose hash is cached after the first O(n) computation.",
              "size_meaning": "n = number of distinct specifiers in the set",
              "make_source": "\ndef make(n):\n    # generate n distinct simple specifiers, e.g. \">=1.0\", \">=2.0\", …\n    specs = [f\">={i}.0\" for i in range(1, n+1)]\n    spec_str = \",\".join(specs)\n    return [[spec_str]]",
              "example_args": [
                [
                  ">=1.0,>=2.0,>=3.0"
                ]
              ],
              "origin": "plan",
              "screen_ratio": 0.413594095426172,
              "valid_fraction": 1.0,
              "error": null
            },
            {
              "id": "F4",
              "kind": "suspected_slowdown",
              "family": "many_specs_equality",
              "why": "__eq__ now sorts both operand tuples (if not already sorted) before comparing, costing up to two O(n log n) sorts. The base version compared two frozensets directly in average O(n). Equality checks on large sets before any __str__ are therefore slower.",
              "size_meaning": "Number of distinct specifiers per set (n). Two equal large sets are created and compared.",
              "make_source": "def make(n):\n    specs = [f\">={i}.0.0\" for i in range(1, n+1)]\n    spec_string = \",\".join(specs)\n    # return two argument lists – the benchmark can build two SpecifierSets and compare them\n    return [[spec_string], [spec_string]]",
              "example_args": [],
              "origin": "plan",
              "screen_ratio": 0.40236402997486365,
              "valid_fraction": 1.0,
              "error": null
            },
            {
              "id": "F5",
              "kind": "suspected_slowdown",
              "family": "Large SpecifierSet where the first __str__ (or __repr__) call triggers the lazy sort",
              "why": "Same lazy‑sort mechanism as hashing. The old implementation built the string by sorting a generator each call (O(n log n) every call). The new version sorts once and caches, but the *first* call still pays the full sort, which is slower than the old frozenset hash path for a single use.",
              "size_meaning": "Number of distinct specifiers.",
              "make_source": "\ndef make(n):\n    specs = [f\"=={i}.0.*\" for i in range(1, n+1)]  # use prefix‑match specifiers to exercise the string path\n    spec_string = \",\".join(specs)\n    return [[spec_string]]",
