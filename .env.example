# Copy to .env (gitignored). Never commit real keys.

# Nebius Token Factory: https://tokenfactory.nebius.com (credit code NEBIUS-DEVPOST-GLOBAL26)
NEBIUS_API_KEY=
# Required for Sandboxes (ConTree). Without beta access every Sandboxes call returns 403.
NEBIUS_PROJECT_ID=
# Optional: base URL override (default https://api.tokenfactory.nebius.com/v1/)
# NEBIUS_BASE_URL=

# Provider for Nemotron calls: tokenfactory (default; the only one whose results may be published)
# or openrouter (development: free Nemotron routes, so prompt tuning doesn't spend Token Factory credit)
# BREAKWATER_PROVIDER=tokenfactory
OPENROUTER_API_KEY=
# Optional OpenRouter route overrides, e.g. a paid route when a free one is rate-limited
# BREAKWATER_OPENROUTER_MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b

# Tavily (promo code BBDEVPOST; Builder Program gives $25)
TAVILY_API_KEY=

# Optional model ID overrides if GET /v1/models shows different casing
# BREAKWATER_MODEL_VOLUME=nvidia/Nemotron-3_5-Lightning
# BREAKWATER_MODEL_PROPOSER=nvidia/nemotron-3-super-120b-a12b
# BREAKWATER_MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
